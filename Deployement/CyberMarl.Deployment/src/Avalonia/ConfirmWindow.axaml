<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CyberMarl.Deployment.AvaloniaApp.ConfirmWindow"
        Title="Confirm" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="#0B0F14">
  <StackPanel Spacing="10" Margin="16">
    <TextBlock Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Name="NoButton" Content="Cancel" MinWidth="90" />
      <Button Name="YesButton" Content="Approve" Classes="primary" MinWidth="90" />
    </StackPanel>
  </StackPanel>
</Window>
