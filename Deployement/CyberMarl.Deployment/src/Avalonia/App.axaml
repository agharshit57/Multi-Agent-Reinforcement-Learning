<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CyberMarl.Deployment.AvaloniaApp.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <!-- Readable dark SOC layer on top of Fluent Dark. Cards and pages
         also set explicit backgrounds, so no surface can fall back to
         a light default. -->
    <!-- Black & yellow SOC layer on top of Fluent Dark: near-black
         surfaces, warm-white text, signal yellow for primary actions,
         active tabs and selection. -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#F5F3EA" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#A8A496" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#141417" />
      <Setter Property="BorderBrush" Value="#2C2C33" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#1E1E24" />
      <Setter Property="Foreground" Value="#F5F3EA" />
      <Setter Property="BorderBrush" Value="#2C2C33" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#FFC400" />
      <Setter Property="Foreground" Value="#141414" />
      <Setter Property="BorderBrush" Value="#C79400" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Foreground" Value="#C9C4B4" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="#3A2E00" />
      <Setter Property="Foreground" Value="#FFD75E" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#101014" />
      <Setter Property="Foreground" Value="#F5F3EA" />
      <Setter Property="CaretBrush" Value="#F5F3EA" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#3A2E00" />
    </Style>
  </Application.Styles>
</Application>
