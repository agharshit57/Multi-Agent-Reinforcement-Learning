<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CyberMarl.Deployment.AvaloniaApp.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <!-- Readable dark SOC layer on top of Fluent Dark. Cards and pages
         also set explicit backgrounds, so no surface can fall back to
         a light default. -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#F2F5F9" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#A9B6C6" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#121924" />
      <Setter Property="BorderBrush" Value="#2B3A4F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#1A2433" />
      <Setter Property="Foreground" Value="#F2F5F9" />
      <Setter Property="BorderBrush" Value="#2B3A4F" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#1D4E89" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Foreground" Value="#C7D2E0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="#1E3A5F" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#0E1520" />
      <Setter Property="Foreground" Value="#F2F5F9" />
      <Setter Property="CaretBrush" Value="#F2F5F9" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E3A5F" />
    </Style>
  </Application.Styles>
</Application>
